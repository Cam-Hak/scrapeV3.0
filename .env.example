# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------
# Crawler identity  (see plan: "identified crawler, not a stealthed one")
# ---------------------------------------------------------------------
# The literal token "bot" in the UA is what crawler-detection code looks for.
# Keep this STABLE - Cloudflare's Verified Bot program requires a stable UA.
SCRAPEV3_USER_AGENT=TNSNewsBot/1.0 (+https://targetednews.com/bot)
SCRAPEV3_CONTACT_EMAIL=crawler@targetednews.com

# ---------------------------------------------------------------------
# Politeness  (per-host; these are floors, robots.txt Crawl-delay wins)
# ---------------------------------------------------------------------
SCRAPEV3_DEFAULT_DELAY_S=5.0
SCRAPEV3_SMALL_SITE_DELAY_S=10.0
SCRAPEV3_MAX_CONCURRENCY_PER_HOST=1
SCRAPEV3_JITTER_PCT=0.30
SCRAPEV3_GLOBAL_CONCURRENCY=32
SCRAPEV3_REQUEST_TIMEOUT_S=20
SCRAPEV3_DNS_TIMEOUT_S=3
# Consecutive refusals (403 / bot wall) before a host is left alone, and for
# how long. A run of them is an answer: news.csub.edu refused fourteen
# consecutive article fetches in one pass, each after the full per-host delay.
# Redirect hops per request. curl defaults to 30 and follows them internally,
# so they bypass per-host pacing; a self-redirect loop turns one polite fetch
# into thirty unpaced ones.
SCRAPEV3_MAX_REDIRECTS=5
SCRAPEV3_MAX_CONSEC_REFUSALS=5
SCRAPEV3_REFUSAL_COOLDOWN_S=900

# ---------------------------------------------------------------------
# Local LLM (Ollama). No API keys anywhere in this project by design.
# ---------------------------------------------------------------------
SCRAPEV3_OLLAMA_HOST=http://127.0.0.1:11434
SCRAPEV3_OLLAMA_MODEL=gpt-oss:20b
# MUST exceed your pruned-DOM token budget. Ollama truncates SILENTLY.
SCRAPEV3_OLLAMA_NUM_CTX=16384

# ---------------------------------------------------------------------
# Storage. Leave MySQL blank to use the JSONL sink (default while unfunded).
# ---------------------------------------------------------------------
# "jsonl" writes files only. "tns" ALSO inserts into tns.press_release,
# which is the live newswire CMS table - set it deliberately.
SCRAPEV3_SINK=jsonl
SCRAPEV3_DATA_DIR=./data
SCRAPEV3_MYSQL_HOST=
SCRAPEV3_MYSQL_PORT=3306
SCRAPEV3_MYSQL_USER=
SCRAPEV3_MYSQL_PASSWORD=
SCRAPEV3_MYSQL_STATE_DB=scrapev3
SCRAPEV3_MYSQL_SINK_DB=tns
# Which backend holds the frontier. Without this, configuring MySQL for the
# sink would also relocate the frontier and leave its SQLite state behind.
SCRAPEV3_FRONTIER=sqlite

# Revisit scheduling. "off" makes every enabled domain permanently due, so a
# site can be re-crawled immediately instead of waiting out its revisit period.
# Prototype setting: cadence then belongs to whatever invokes the crawler.
# This relaxes ONLY the calendar. The domain lease, the per-host delay and the
# per-IP cap are untouched, so a crawl stays exactly as polite.
SCRAPEV3_SCHEDULE=off

# ---------------------------------------------------------------------
# The tns.press_release contract. v2's thresholds; change with care, they
# decide what an editor sees.
# ---------------------------------------------------------------------
# At or below this word count the document is not loaded at all.
SCRAPEV3_TNS_MIN_WORDS=100
# Above the floor but at or below this, load with status W for review.
SCRAPEV3_TNS_SHORT_DOC_MAX_WORDS=250
# The editorial box a normal document lands in.
SCRAPEV3_TNS_STATUS=D
# Characters of the headline's tail in the "$H " filename.
SCRAPEV3_TNS_FILENAME_CHARS=10
# url_grp.descrip filter - v2's "lede filter". % is every editorial group.
SCRAPEV3_TNS_GROUP_FILTER=%
