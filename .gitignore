# --- secrets -----------------------------------------------------------
# v1 committed configs/db_config.yml (DB root password) and v2 committed
# configs/my_mail.py (SMTP password). Both are still in those repos' history.
# These rules are deliberately broad: it is much cheaper to un-ignore one
# file than to scrub a credential out of git history.
.env
.env.*
!.env.example
*secret*
*credential*
*password*
key
keys/
*.pem
*.key
!ops/webbotauth/*.pub

# --- config that tends to hold hosts/users -----------------------------
*_config.yml
*_config.yaml
db_config.*
my_mail.*

# --- python ------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# --- runtime data ------------------------------------------------------
# The derived site lists (data/sites.*, data/survey_sample.txt) ARE inputs and
# should be versioned. Only crawl output and survey runs are ignored.
logs/
data/surveys/
data/articles/
# Rendered views of a crawl, not the crawl. Both are regenerated in one
# command (`scrapev3 status --json` / `--html`) and status.html is a
# megabyte of embedded rows that changes on every pass.
data/status.json
data/status.html
*.sqlite
*.db
# SQLite write-ahead log and shared-memory files. Transient state that every
# crawl rewrites - articles.sqlite-wal was 3 MB of binary churn per commit.
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.jsonl

# --- database dumps ----------------------------------------------------
# dbs/ holds restores of the live tns schema: 34k agency rows carrying editor
# usernames and per-agency instructions, plus 21 MB of data that has no
# business in git. The schema they define is documented in the README instead.
dbs/
*.dmp.sql

# --- os / editor -------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
